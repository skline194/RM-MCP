    },
    "CreditCardTransactions": {
      "path": "/CreditCardTransactions",
      "methods": {
        "GET": "id_path_documented_collection_filter_unproven",
        "POST": "guarded_dry_run_default_2026-10-29"
      },
      "key_fields": [
        "ID",
        "CreditCardID",
        "AccountID",
        "TransactionDate",
        "Reference",
        "Comment"
      ],
      "notes": [
        "Not a vendor bill. Not a tenant rent receipt. Payee AccountID is VendorID.",
        "Create+attach: POST ?embeds=CreditCardTransactionDetails,Attachments. Multipart text part name is lowercase body. File part name equals MetaTag.",
        "Header Amount is ignored. Do not send TransactionType.",
        "embeds=Attachments required or the file is silently dropped.",
        "Existing file: POST /CreditCardTransactions/{ID}/Attachments",
        "Update: POST with fields= mask. No PUT/PATCH. v1 mask is Comment, Reference, TransactionDate.",
        "Not live-verified. Do not close work orders. Do not post rent receipts."
      ]
    },
    "Banks": {
      "path": "/Banks",
      "methods": {
        "GET": "documented_2026-10-29_not_live_probed"
      },
      "key_fields": [
        "BankID",
        "Name"
      ],
      "notes": [
        "Lookup only. Alexander James 2026-10-29: GET /Banks?fields=BankID,Name",
        "BankID is the bank GL account ID used on Checks"
      ]
    },
    "Checks": {
      "path": "/Checks",
      "methods": {
        "GET": "id_path_documented_collection_filter_unproven",
        "POST": "guarded_dry_run_default_2026-10-29"
      },
      "key_fields": [
        "ID",
        "BankID",
        "AccountID",
        "TransactionDate",
        "Reference",
        "Comment",
        "Payee"
      ],
      "notes": [
        "Paid bank receipt. Not a vendor bill. Not a tenant rent receipt. Not a history note.",
        "Create+attach: POST ?embeds=CheckDetails,FileAttachments. Multipart text part name is lowercase body. File part name equals MetaTag (example File1).",
        "Header Amount is ignored. Payee is not filled from the vendor.",
        "embeds=FileAttachments required or the file is silently dropped.",
        "Reference max 25 characters.",
        "Non-default bank: saveOptions=IgnorePropDefaultBankWarning,true plus Write checks from banks that are not default.",
        "Existing file: POST /Checks/{ID}/FileAttachments. UploadAttachment is the no-JSON alternate.",
        "Update: POST with fields= mask. No PUT/PATCH. v1 mask is Comment, Reference, Payee, TransactionDate.",
        "Not live-verified. Do not close work orders. Do not post rent receipts."
      ]
    }
