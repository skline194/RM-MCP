        "UnitID",
        "Name",
        "PropertyID",
        "SquareFootage",
        "Bedrooms",
        "Bathrooms"
      ],
      "proven_embeds": [
        "UserDefinedValues"
      ],
      "notes": [
        "Never /Units/search",
        "Do not pass fields= with embeds",
        "History POST 405; use POST .../HistoryNotes for history notes"
      ],
      "nested": {
        "history": "/Units/{id}/History",
        "history_notes": "/Units/{id}/HistoryNotes"
      }
    },
