    "ServiceManagerIssues": {
      "path": "/ServiceManagerIssues",
      "methods": {
        "GET": "ok",
        "POST": "ok_create_and_upsert_update",
        "PATCH": "method_not_allowed",
        "PUT": "method_not_allowed"
      },
      "proven_embeds": [
        "Status",
        "Units",
        "Properties",
        "Tenants",
        "Vendor",
        "AssignedToUser"
      ],
      "nested": {
        "units": "/ServiceManagerIssues/{id}/Units",
        "history": "/ServiceManagerIssues/{id}/History",
        "tasks": "/ServiceManagerIssues/{id}/Tasks",
        "link_units": "/ServiceManagerIssues/{id}/LinkUnits",
        "link_properties": "/ServiceManagerIssues/{id}/LinkProperties",
        "link_tenants": "/ServiceManagerIssues/{id}/LinkTenants"
      },
      "notes": [
        "IsClosed filter works",
        "PropertyID may be null on bare payload; use embeds=Properties/Units/Tenants",
        "Updates: POST collection with ServiceManagerIssueID (PATCH/PUT 405)",
        "Mutable upsert fields: Title, Description, Resolution, CustomerDescription, NoteText, StatusID, AssignedToUserID",
        "Link entities: POST .../LinkUnits|LinkProperties|LinkTenants with raw int array (append)",
        "Unlink* routes 404 on this account"
      ]
    },
