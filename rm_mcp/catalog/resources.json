{
  "version": 1,
  "updated": "2026-10-29",
  "strategy": "Prefer coarse RM filters + Python join/filter/sort. Only use proven embeds/filters.",
  "resources": {
    "Properties": {
      "path": "/Properties",
      "methods": {
        "GET": "ok"
      },
      "key_fields": [
        "PropertyID",
        "Name",
        "ShortName",
        "IsActive"
      ],
      "notes": [
        "Identity filters safe",
        "fields= OK without embeds",
        "History POST 405; use POST .../HistoryNotes for history notes"
      ],
      "nested": {
        "history": "/Properties/{id}/History",
        "history_notes": "/Properties/{id}/HistoryNotes"
      }
    },
    "Units": {
